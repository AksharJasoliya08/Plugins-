@model SlidePictureModel

<div class="card card-default">
    <div class="card-header">
        @T("Plugins.Widgets.Swiper.Slide")
    </div>
    <div class="card-body">
        <div class="form-group row advanced-setting">
            <div class="col-md-3">
                <nop-label asp-for="ContentType" />
            </div>
            <div class="col-md-9">
                <div class="form-check form-check-inline">
                    <input class="form-check-input"
                           type="radio"
                           asp-for="ContentType"
                           value="0"
                           id="ContentTypeImage" />
                    <label class="form-check-label" for="ContentTypeImage">
                        @T("Plugins.Widgets.Swiper.ContentType.Image")
                    </label>
                </div>
                <div class="form-check form-check-inline" style="margin-left:20px;">
                    <input class="form-check-input"
                           type="radio"
                           asp-for="ContentType"
                           value="1"
                           id="ContentTypeUploadedVideo" />
                    <label class="form-check-label" for="ContentTypeUploadedVideo">
                        @T("Plugins.Widgets.Swiper.ContentType.UploadedVideo")
                    </label>
                </div>
                <div class="form-check form-check-inline" style="margin-left:20px;">
                    <input class="form-check-input"
                           type="radio"
                           asp-for="ContentType"
                           value="2"
                           id="ContentTypeExternalVideo" />
                    <label class="form-check-label" for="ContentTypeExternalVideo">
                        @T("Plugins.Widgets.Swiper.ContentType.ExternalVideo")
                    </label>
                </div>
            </div>
        </div>

        <!-- Image Fields -->
        <div id="image-fields-section">
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="PictureId" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="PictureId" />
                    <span asp-validation-for="PictureId"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="AltText" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="AltText" />
                    <span asp-validation-for="AltText"></span>
                </div>
            </div>
        </div>

        <!-- Uploaded Video Fields -->
        <div id="uploaded-video-fields-section" style="display:none;">
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoUrl" />
                </div>
                <div class="col-md-9">
                    <div class="input-group">
                        <nop-editor asp-for="VideoUrl" class="form-control" id="VideoUrl" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-secondary" id="btn-upload-video">
                                <i class="fas fa-upload"></i> @T("Admin.Common.Upload")
                            </button>
                        </div>
                    </div>
                    <input type="file" id="videoFile" accept="video/mp4,video/webm" style="display:none;" />
                    <small class="form-text text-muted">@T("Plugins.Widgets.Swiper.VideoUpload.HelpText")</small>
                    
                    <!-- Upload progress -->
                    <div id="video-upload-progress" style="display:none;" class="mt-2">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm text-primary mr-2" role="status"></div>
                            <span class="text-muted">@T("Plugins.Widgets.Swiper.VideoUpload.Uploading")</span>
                        </div>
                    </div>
                    
                    <!-- Upload messages -->
                    <div id="video-upload-error" class="alert alert-danger mt-2" style="display:none;"></div>
                    <div id="video-upload-success" class="alert alert-success mt-2" style="display:none;"></div>
                    
                    <!-- Video preview -->
                    <div id="video-preview-container" class="mt-3" style="display:none;">
                        <label class="form-label">@T("Plugins.Widgets.Swiper.VideoPreview")</label>
                        <video id="video-preview" width="400" controls class="border rounded">
                            <source src="" type="video/mp4" />
                            @T("Plugins.Widgets.Swiper.VideoNotSupported")
                        </video>
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-secondary" id="btn-replace-video">
                                <i class="fas fa-sync"></i> @T("Plugins.Widgets.Swiper.ReplaceVideo")
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" id="btn-remove-video">
                                <i class="fas fa-trash"></i> @T("Plugins.Widgets.Swiper.RemoveVideo")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="PosterPictureId" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="PosterPictureId" asp-template="Picture" />
                    <span asp-validation-for="PosterPictureId"></span>
                    <small class="form-text text-muted">@T("Plugins.Widgets.Swiper.PosterPictureId.Hint")</small>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoAutoplay" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoAutoplay" />
                    <span asp-validation-for="VideoAutoplay"></span>
                    <small class="form-text text-muted">@T("Plugins.Widgets.Swiper.VideoAutoplay.Hint")</small>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoMuted" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoMuted" />
                    <span asp-validation-for="VideoMuted"></span>
                    <small class="form-text text-muted">@T("Plugins.Widgets.Swiper.VideoMuted.Hint")</small>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoLoop" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoLoop" />
                    <span asp-validation-for="VideoLoop"></span>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoControls" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoControls" />
                    <span asp-validation-for="VideoControls"></span>
                </div>
            </div>
        </div>

        <!-- External Video URL Fields -->
        <div id="external-video-fields-section" style="display:none;">
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="ExternalVideoUrl" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="ExternalVideoUrl" />
                    <span asp-validation-for="ExternalVideoUrl"></span>
                    <small class="form-text text-muted">@T("Plugins.Widgets.Swiper.ExternalVideoUrl.Hint")</small>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="PosterPictureId" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="PosterPictureId" asp-template="Picture" />
                    <span asp-validation-for="PosterPictureId"></span>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoAutoplay" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoAutoplay" />
                    <span asp-validation-for="VideoAutoplay"></span>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoMuted" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoMuted" />
                    <span asp-validation-for="VideoMuted"></span>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoLoop" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoLoop" />
                    <span asp-validation-for="VideoLoop"></span>
                </div>
            </div>
            
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="VideoControls" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="VideoControls" />
                    <span asp-validation-for="VideoControls"></span>
                </div>
            </div>
        </div>

        <!-- Common Fields -->
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="TitleText" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="TitleText" />
                <span asp-validation-for="TitleText"></span>
            </div>
        </div>
        
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Description" />
            </div>
            <div class="col-md-9">
                <nop-textarea asp-for="Description" rows="3" />
                <span asp-validation-for="Description"></span>
                <small class="form-text text-muted">@T("Plugins.Widgets.Swiper.Description.Hint")</small>
            </div>
        </div>
        
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="LinkUrl" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="LinkUrl" />
                <span asp-validation-for="LinkUrl"></span>
            </div>
        </div>
        
        <div class="form-group row">
            <div class="offset-md-3 col-md-9">
                <button type="submit" name="add-slide" class="btn btn-primary">@T("Plugins.Widgets.Swiper.Slide.Add")</button>
            </div>
        </div>
    </div>
</div>

<script asp-location="Footer">
    $(document).ready(function () {
        // Toggle field visibility based on content type
        function toggleFields() {
            var contentType = $('input[name="ContentType"]:checked').val();
            
            $('#image-fields-section').toggle(contentType == '0');
            $('#uploaded-video-fields-section').toggle(contentType == '1');
            $('#external-video-fields-section').toggle(contentType == '2');
        }
        
        // Initial toggle
        toggleFields();
        
        // On content type change
        $('input[name="ContentType"]').on('change', function () {
            toggleFields();
        });
        
        // Video upload button
        $('#btn-upload-video').on('click', function () {
            $('#videoFile').click();
        });
        
        // Replace video button
        $('#btn-replace-video').on('click', function () {
            $('#videoFile').click();
        });
        
        // Remove video button
        $('#btn-remove-video').on('click', function () {
            $('#VideoUrl').val('');
            $('#video-preview-container').hide();
            $('#video-upload-success').hide();
        });
        
        // File input change
        $('#videoFile').on('change', function () {
            var file = this.files[0];
            if (!file) return;
            
            // Validate file type
            var validTypes = ['video/mp4', 'video/webm'];
            if (validTypes.indexOf(file.type) === -1) {
                showVideoError('@T("Plugins.Widgets.Swiper.VideoUpload.InvalidType")');
                return;
            }
            
            // Validate file size (max 50MB)
            var maxSize = 50 * 1024 * 1024;
            if (file.size > maxSize) {
                showVideoError('@T("Plugins.Widgets.Swiper.VideoUpload.FileTooLarge")');
                return;
            }
            
            // Upload file
            var formData = new FormData();
            formData.append('videoFile', file);
            
            $('#video-upload-progress').show();
            $('#video-upload-error').hide();
            $('#video-upload-success').hide();
            
            $.ajax({
                url: '@Url.Action("UploadVideo", "WidgetSwiper")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    $('#video-upload-progress').hide();
                    if (res.success) {
                        $('#VideoUrl').val(res.url);
                        updateVideoPreview(res.url);
                        showVideoSuccess('@T("Plugins.Widgets.Swiper.VideoUpload.Success")');
                    } else {
                        showVideoError(res.message || '@T("Plugins.Widgets.Swiper.VideoUpload.Failed")');
                    }
                },
                error: function () {
                    $('#video-upload-progress').hide();
                    showVideoError('@T("Plugins.Widgets.Swiper.VideoUpload.Error")');
                }
            });
        });
        
        function updateVideoPreview(url) {
            if (url) {
                $('#video-preview source').attr('src', url);
                $('#video-preview')[0].load();
                $('#video-preview-container').show();
            } else {
                $('#video-preview-container').hide();
            }
        }
        
        function showVideoError(msg) {
            $('#video-upload-error').text(msg).show();
        }
        
        function showVideoSuccess(msg) {
            $('#video-upload-success').text(msg).show();
            setTimeout(function () {
                $('#video-upload-success').fadeOut();
            }, 5000);
        }
        
        // Show existing video preview on page load
        var existingVideoUrl = $('#VideoUrl').val();
        if (existingVideoUrl) {
            updateVideoPreview(existingVideoUrl);
        }
    });
</script>