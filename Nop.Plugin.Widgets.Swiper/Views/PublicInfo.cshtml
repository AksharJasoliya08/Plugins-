@model PublicInfoModel
@{
    Layout = "";
}

<link href="~/Plugins/Widgets.Swiper/Content/css/swiper-bundle.min.css" rel="stylesheet">
<link href="~/Plugins/Widgets.Swiper/Content/css/styles.css" rel="stylesheet">
<script src="~/Plugins/Widgets.Swiper/Content/js/swiper-bundle.min.js" asp-location="Footer"></script>

@if (Model.Slides?.Any() == true)
{
    <div class="swiper nop-slider">
        <div class="swiper-wrapper">
            @foreach (var slide in Model.Slides)
            {
                @await Html.PartialAsync("~/Plugins/Widgets.Swiper/Views/_PublicInfo.Slide.cshtml", slide)
            }
        </div>
        @if (Model.ShowPagination)
        {
            <div class="swiper-pagination"></div>
        }
        @if (Model.ShowNavigation)
        {
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        }
    </div>
}

<script asp-location="Footer">
    var swiper6 = new Swiper(".nop-slider", {
      autoHeight: true,
        grabCursor: true,
        effect: "fade",
        lazy: true,
        @if (Model.Autoplay)
        {
            <text>
            autoplay: {
                delay: @Model.AutoplayDelay
            },
            </text>
        }
        @if (Model.ShowPagination)
        {
            <text>
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            </text>
        }
        @if (Model.ShowNavigation)
        {
            <text>
            navigation: {
                nextEl: ".swiper-button-next",
                prevEl: ".swiper-button-prev",
            },
            </text>
        }
        on: {
            init: function () {
                pauseAllVideosExcept(this.slides[this.activeIndex]);
            },
            slideChange: function () {
                // Pause all videos first
                pauseAllVideos();
                // Play video in active slide if autoplay is enabled
                var activeSlide = this.slides[this.activeIndex];
                if (activeSlide) {
                    playVideoInSlide(activeSlide);
                }
            }
        }
    });
    
    // Helper functions for video control
    function pauseAllVideos() {
        var videos = document.querySelectorAll('.nop-slider video');
        videos.forEach(function(video) {
            if (!video.paused) {
                video.pause();
            }
        });
    }
    
    function pauseAllVideosExcept(currentSlide) {
        var videos = document.querySelectorAll('.nop-slider .swiper-slide:not(.swiper-slide-active) video');
        videos.forEach(function(video) {
            if (!video.paused) {
                video.pause();
            }
        });
    }
    
    function playVideoInSlide(slide) {
        var video = slide.querySelector('video');
        if (video) {
            var autoplay = video.hasAttribute('autoplay');
            if (autoplay) {
                video.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                });
            }
        }
    }
    
    // Handle video click to toggle play/pause when controls are not shown
    document.addEventListener('click', function(e) {
        if (e.target.closest('.slider-video')) {
            var video = e.target.closest('.slider-video');
            if (!video.hasAttribute('controls')) {
                if (video.paused) {
                    video.play();
                } else {
                    video.pause();
                }
            }
        }
    });
</script>